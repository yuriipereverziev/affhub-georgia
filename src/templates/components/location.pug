    .location__video__wrapper

      p.location__text= videoText


      .location__video
        .location__video-inner
          img.location__video-preload(src="img/preview.png" alt="Preview")

          iframe.location__video-iframe(
            src="https://www.youtube.com/embed/ZhyGebbIv6Q?autoplay=0&modestbranding=1&enablejsapi=1"
            title="Conference video"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
          )

        button.location__video-play(
          type="button"
          aria-label="Play video"
