  ]


  const REAL_SPEAKERS_COUNT = 3
  const TOTAL_SPEAKERS_COUNT = 6
  const realSpeakers = speakersList.slice(0, REAL_SPEAKERS_COUNT)
  const secretSpeakersCount = Math.max(TOTAL_SPEAKERS_COUNT - realSpeakers.length, 0)


.block.speakers.speakers__wrapper#speakers
  .container



    .speakers__top

      h2.speakers__title.title= speakersTitle

      button.speakers__arrow.speakers__arrow--prev
        svg(xmlns='http://www.w3.org/2000/svg' width='28' height='20' fill='none')
          path(fill='#100730' d='M10.762 19.603c-.52.53-1.365.53-1.886 0L.391 10.96c-.521-.53-.521-1.39 0-1.92L8.876.398c.521-.53 1.365-.53 1.886 0s.52 1.39 0 1.92l-6.21 6.324h22.115C27.403 8.642 28 9.25 28 10s-.597 1.358-1.333 1.358H4.552l6.21 6.324c.52.53.52 1.39 0 1.92')

      button.speakers__arrow.speakers__arrow--next
        svg(xmlns='http://www.w3.org/2000/svg' width='28' height='20' fill='none')
          path(fill='#100730' d='M17.238 19.603c.52.53 1.365.53 1.886 0l8.486-8.643c.52-.53.52-1.39 0-1.92L19.124.398a1.317 1.317 0 0 0-1.886 0c-.52.53-.52 1.39 0 1.92l6.21 6.324H1.333C.597 8.642 0 9.25 0 10s.597 1.358 1.333 1.358h22.115l-6.21 6.324c-.52.53-.52 1.39 0 1.92')


    .speakers__inner.swiper
      .speakers__wrapper.swiper-wrapper

        // настоящие спикеры
        each speaker in realSpeakers
          .speakers__slide.swiper-slide
            img.speakers__img(
              src=`/img/${speaker.img}.png`
              alt=speaker.name
              width=speaker.width
              height=speaker.height
              loading="lazy"
            )
            .speakers__desc
              span.speakers__name
                | #{speaker.firstName}
                br
                | #{speaker.lastName}
              span.speakers__position= speaker.position

        // секретные спикеры
        each i in Array(secretSpeakersCount)
          .speakers__slide.speakers__slide--secret.swiper-slide
            img.speakers__img(
              src="/img/speaker.png"
              alt=secretSpeakerLabel
              width="155"
              height="177"
              loading="lazy"
            )
            .speakers__label.text-upper= secretSpeakerLabel


